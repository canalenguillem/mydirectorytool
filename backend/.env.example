GOOGLE_API_KEY=
OPENAI_API_KEY=
WP_URL=https://yoursite.com
WP_USER=
WP_APP_PASS=
DATA_DIR=/data
CORS_ORIGINS=http://localhost:8091
# Pausa entre peticiones de detalles al buscar comercios (segundos)
GOOGLE_DETAILS_DELAY_SECONDS=0.25
# Siembra masiva por ciudad (ver docs/inventories/2026-07-30-seed-queue.md)
# Sector buscado por defecto al iniciar la cola de siembra (peluquerias, dentistas...)
DIRECTORY_SEARCH_TERM=restaurantes
# Pausa entre paginas de Text Search New (segundos) -- Google exige un
# pequeno delay antes de que nextPageToken sea valido
GOOGLE_TEXT_SEARCH_PAGE_DELAY_SECONDS=2
# Maximo de paginas de Text Search New por ciudad (3 = hasta 60 candidatos)
GOOGLE_SEED_MAX_PAGES=3
# Minimo de resenas para entrar en el corte principal del ranking top-20
GOOGLE_SEED_MIN_USER_RATINGS=15
# Si true, guarda automaticamente en `place` los 20 elegidos de cada ciudad
SEED_AUTOSAVE=true
AUTH_USERNAME=enguillem
AUTH_PASSWORD=change-this-password
# Genera uno con: openssl rand -hex 32
AUTH_SECRET=change-this-random-secret
AUTH_SESSION_SECONDS=43200
# Usa true cuando la web se sirva exclusivamente mediante HTTPS
AUTH_COOKIE_SECURE=false
